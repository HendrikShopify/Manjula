{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run tokens)",
      "Bash(npm run gallery)",
      "Bash(node scripts/*)",
      "Bash(node tests/*)",
      "Bash(npx @tailwindcss/cli *)",
      "Bash(shopify theme check*)",
      "Bash(shopify theme dev*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "mcp__figma__get_design_context",
      "mcp__figma__get_screenshot",
      "mcp__figma__get_metadata",
      "mcp__figma__get_variable_defs"
    ],
    "deny": [
      "Bash(shopify theme publish*)",
      "Bash(shopify theme push --live*)",
      "Bash(shopify theme delete*)",
      "Bash(git push --force*)"
    ]
  }
}
