<!doctype html>
<html class="js motion-safe:scroll-smooth" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    {%- unless request.design_mode -%}
      {%- if template.name == 'collection' or template.name == 'list-collections' -%}
        {%- comment -%}
          No collection pages in the store yet: the collection and collection-listing pages send visitors to the home page.
          replace() keeps the back button working. Not in the theme editor, so the templates stay editable.
        {%- endcomment -%}
        <script>
          window.location.replace({{ routes.root_url | json }});
        </script>
      {%- endif -%}
    {%- endunless -%}
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %}
        &ndash; tagged "{{ current_tags | join: ', ' }}"
      {%- endif -%}
      {%- if current_page != 1 %}
        &ndash; Page {{ current_page -}}
      {%- endif -%}
      {%- unless page_title contains shop.name %}
        &ndash; {{ shop.name -}}
      {%- endunless -%}
    </title>

    {%- assign meta_description = page_description | default: shop.description -%}
    {% if meta_description != blank %}
      <meta name="description" content="{{ meta_description | strip_html | truncate: 320 | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {% render 'fonts' %}

    <script src="{{ 'gsap.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'CustomEase.min.js' | asset_url }}" defer="defer"></script>

    <script src="{{ 'format-money.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'base-component.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'text-trim-fallback.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'variant-selects.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'side-drawer.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'custom-select.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'rating-input.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'card-swatches.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'custom-tabs.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'marquee-slider.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {{ 'tailwind.output.css' | asset_url | stylesheet_tag }}

    {%- if localization.available_languages.size > 1 or localization.available_countries.size > 1 -%}
      <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- unless request.design_mode -%}
      {%- if template.name == 'index' -%}
        <script>
          // Home page-load intro (Figma: Home / Desktop / Page load). Set before first paint so the header starts under
          // the hero wordmark; hero-intro.js animates it into place. Desktop only, every home page load, never with reduced motion.
          // The timer is a safety net: if the script never runs, the page settles into its normal state.
          (function () {
            try {
              var root = document.documentElement;
              if (!matchMedia('(min-width: 1024px)').matches) return;
              if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
              root.classList.add('intro');
              window.__introTimer = setTimeout(function () {
                root.classList.remove('intro');
              }, 4000);
            } catch (e) {}
          })();
        </script>
      {%- endif -%}
    {%- endunless -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>

  <body class="bg-background text-text font-primary antialiased has-[[data-scroll-lock=true]]:overflow-hidden">
    <a class="sr-only" href="#MainContent"> Skip to main content </a>

    {% render 'loading-bar' %}

    {%- render 'cart-drawer' -%}
    {%- render 'search-drawer' -%}
    {%- render 'quick-view' -%}
    {%- capture side_drawer_content -%}
      <p class="text-sm text-gray-600">Side drawer content goes here.</p>
    {%- endcapture -%}

    {% sections 'header-group' %}

    <main
      id="MainContent"
      class=""
      role="main"
      tabindex="-1"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'javascript-strings' %}
    {%- comment -%} Newsletter popup is off for Manjula (Hendrik, 23 Nov). To turn it on: {% render 'newsletter-popup' %} {%- endcomment -%}
    {% section 'cookie-consent' %}
  </body>
</html>
