{%- comment -%}
  Figma: Components Atoms / Block / Testimonial (2170:25622)
  Stars (Rating stars sm), the quote in body/lg, then a 40px round avatar beside name and role (body/xs). 20px apart.
  Padding defaults to 12px top and bottom, as in Figma.
  Landing block (private: the underscore keeps it out of every other section; only the Landing columns and tabs list it).
  Top and bottom padding are settings on the Figma Spacing scale (spacing/N = N x 4px), as pt-N / pb-N (Hendrik, 24 Nov).
{%- endcomment -%}
<div class="landing-block min-w-0 pt-{{ block.settings.padding_top }} pb-{{ block.settings.padding_bottom }}" {{ block.shopify_attributes }}>
  <figure class="flex flex-col gap-5 text-text">
    {% render 'rating-stars', value: block.settings.rating, size: 'sm' %}
    <blockquote class="text-body-lg"><p>{{ block.settings.quote | escape | newline_to_br }}</p></blockquote>
    {%- if block.settings.name != blank or block.settings.avatar != blank -%}
      <figcaption class="flex items-center gap-3">
        {%- if block.settings.avatar != blank -%}
          <span class="size-10 shrink-0 overflow-hidden rounded-full bg-surface-alt">
            {{- block.settings.avatar | image_url: width: 120 | image_tag: alt: '', sizes: '40px', widths: '40, 80, 120', loading: 'lazy', class: 'size-full object-cover' -}}
          </span>
        {%- endif -%}
        <p class="text-body-xs">
          {{- block.settings.name | escape -}}
          {%- if block.settings.role != blank %}<br>{{ block.settings.role | escape }}{% endif -%}
        </p>
      </figcaption>
    {%- endif -%}
  </figure>
</div>

