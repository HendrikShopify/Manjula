{%- comment -%}
  Figma: Components Atoms / Block / Before after (2173:33742): Before after slider, square, the full column width
  Landing block (private: the underscore keeps it out of every other section; only the Landing columns and tabs list it).
  Top and bottom padding are settings on the Figma Spacing scale (spacing/N = N x 4px), as pt-N / pb-N (Hendrik, 24 Nov).
  Size: Aspect ratio (a list, or Custom with a width and a height) and Width on desktop and on mobile in % of the column
  (Hendrik, 25 Nov). Custom properties on the frame: --media-ratio, --media-width, --media-width-mobile.
{%- endcomment -%}
{%- liquid
  assign ratio = block.settings.ratio
  if ratio == 'custom'
    assign ratio_w = block.settings.ratio_width | default: 1 | at_least: 1
    assign ratio_h = block.settings.ratio_height | default: 1 | at_least: 1
    assign ratio = ratio_w | append: ' / ' | append: ratio_h
  else
    assign ratio = ratio | replace: '/', ' / '
  endif
  assign half = block.settings.width | divided_by: 2
  assign sizes = '(min-width: 1024px) ' | append: half | append: 'vw, ' | append: block.settings.width_mobile | append: 'vw'
-%}
<div class="landing-block min-w-0 pt-{{ block.settings.padding_top }} pb-{{ block.settings.padding_bottom }}" {{ block.shopify_attributes }}>
  <div class="w-(--media-width-mobile) max-w-full lg:w-(--media-width)" style="--media-ratio: {{ ratio }}; --media-width: {{ block.settings.width }}%; --media-width-mobile: {{ block.settings.width_mobile }}%;">
    {% render 'before-after-slider',
      before: block.settings.before_image,
      after: block.settings.after_image,
      show_labels: block.settings.show_labels,
      sizes: sizes,
      class: 'aspect-(--media-ratio) min-h-0 w-full'
    %}
  </div>
</div>

{% schema %}
