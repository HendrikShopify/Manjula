{%- comment -%}
  Figma: Components Atoms / Block / Paragraph (2170:25571): body/sm
  Landing block (private: the underscore keeps it out of every other section; only the Landing columns and tabs list it).
  Top and bottom padding are settings on the Figma Spacing scale (spacing/N = N x 4px), as pt-N / pb-N (Hendrik, 24 Nov).
  size          the text style from lg: body/lg, base, sm (default) or xs (Hero text: body-lg)
  size_mobile   the text style below lg. Colour comes from the section.
{%- endcomment -%}
{%- liquid
  assign size = block.settings.size | default: 'body-sm'
  assign size_mobile = block.settings.size_mobile | default: size
-%}
<div class="landing-block min-w-0 pt-{{ block.settings.padding_top }} pb-{{ block.settings.padding_bottom }}" {{ block.shopify_attributes }}>
  <div class="flex flex-col gap-4 text-{{ size_mobile }} lg:text-{{ size }} [&_a]:underline [&_a]:underline-offset-2">{{ block.settings.text }}</div>
</div>

