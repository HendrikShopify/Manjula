{%- comment -%}
  Figma: Two columns narrow (2741:4793): one topic. It renders its row in the topic list (List row lg, the title) and
  its content column, shown while the topic is selected (landing-tabs.js). The section places them (see its comment).
  Same column settings as the Landing column, without sticky. The first tab shows before the script runs.
  Private: only Two columns narrow uses it.
{%- endcomment -%}
{%- liquid
  assign first_tab = section.blocks | first
  assign panel_id = 'LandingTab-' | append: block.id
  assign is_first = false
  if first_tab.id == block.id
    assign is_first = true
  endif
  capture panel_attributes
    echo 'id="' | append: panel_id | append: '" data-landing-tab-panel="' | append: block.id | append: '" '
    echo block.shopify_attributes
    unless is_first
      echo ' hidden'
    endunless
  endcapture
-%}
{%- capture content -%}{% content_for 'blocks' %}{%- endcapture -%}
{%- capture tab_attributes -%}data-landing-tab="{{ block.id }}" aria-controls="{{ panel_id }}"{%- endcapture -%}
  {% render 'list-row', label: block.settings.title, size: 'lg', active: is_first, attributes: tab_attributes, class: 'lg:col-span-4 lg:col-start-1' %}
  {% render 'landing-column', content: content, settings: block.settings, attributes: panel_attributes, class: 'order-1 max-lg:mt-10 lg:col-span-6 lg:col-start-5 lg:row-[1/-1]' %}

