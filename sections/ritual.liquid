{%- comment -%}
  Figma: Sections / Ritual (Templates FEEDBACK Science "Power of ritual" 2701:25928,
  mobile 2701:25937). Own section (one section per layout) on the breakout grid (.section-breakout, tailwind/tokens.css).
  Desktop: bracketed content over columns 1 to 4 (small square photo, eyebrow as the heading, body/sm story at 60%, a
  small button), the photo from column 5 to the right edge (943:892).
  Mobile: the photo edge to edge first (390:369, no top padding), then the bracketed content stacked; the eyebrow is
  one size up (16px dot, heading/3).
  Both photos can be a video instead (Hendrik, 23 Nov): a video plays muted and looped and wins over its photo.
  No parallax: the photos stay still (Hendrik, 23 Nov; the <paralax-img> effect was removed site wide).
{%- endcomment -%}
{%- liquid
  assign main_media = section.settings.video | default: section.settings.image
  assign small_media = section.settings.video_small | default: section.settings.image_small
-%}
<section class="ritual section-shell bg-background text-text max-lg:pt-0!" data-padding-top="md" data-padding-bottom="md">
  <div class="section-breakout gap-y-4 lg:gap-y-6">
    <div class="relative flex flex-col items-start gap-8 p-6 max-lg:order-2 lg:self-start" style="--start-mobile: 1; --span-mobile: 4; --start: 1; --span: 4;">
      {% render 'bracket', side: 'left', size: 'md', strength: 'light' %}
      {%- if small_media != blank -%}
        {% render 'media', media: small_media, ratio: 'fill', autoplay: true, sizes: '(min-width: 1024px) 217px, 160px', class: 'size-40 shrink-0 lg:size-54.25' %}
      {%- endif -%}
      {% render 'eyebrow', label: section.settings.heading, size: 'lg', mobile_size: 'xl', tag: 'h2' %}
      {%- if section.settings.text != blank -%}
        <div class="rte text-body-sm opacity-60 [&_p+p]:mt-5.25">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        {% render 'button', label: section.settings.button_label, href: section.settings.button_link, size: 'sm' %}
      {%- endif -%}
    </div>
    <div data-bleed="right" class="max-lg:order-1 max-lg:col-[full-start/full-end]! lg:self-start" style="--start: 5;">
      <div class="relative aspect-[390/369] w-full overflow-hidden rounded-media bg-surface-alt lg:aspect-[943/892]">
        {% render 'media', media: main_media, ratio: 'fill', autoplay: true, sizes: '(min-width: 1024px) 66vw, 100vw', class: 'absolute! inset-0 size-full' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ritual",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Runs to the right edge on desktop" },
    { "type": "video", "id": "video", "label": "Video", "info": "Optional. Plays muted and looped instead of the photo; the photo is not needed then." },
    { "type": "image_picker", "id": "image_small", "label": "Small photo" },
    { "type": "video", "id": "video_small", "label": "Small video", "info": "Optional. Plays muted and looped instead of the photo; the photo is not needed then." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The power of ritual" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "About Manjula" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Ritual" }]
}
{% endschema %}
