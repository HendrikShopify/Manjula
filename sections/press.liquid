{%- comment -%}
  Figma: Sections / Press (2088:32032), wraps Press logo (169:5889) and Press wordmark (172:6360)
  items        Press item metaobjects (press_item: name, logo, quote, excerpt, article_link), picked in the Press items
               setting; with none picked, every Press item entry shows, in admin order
  The article link under the quote reads sections.press.read_article (locales).
  id           unique id prefix for the tabs (section.id)
  Centred outlet quote (serif/lg, serif/display from lg; no top padding on mobile) with an article link, above a row of outlet logos between
  dashed rules (2px dash, 2px gap, Ink 10%) that fade in over the first 20% and out over the last 20% (Figma: gradient stroke on Rules). The logos are tabs (press-tabs.js, built on custom-tabs.js): the selected outlet's quote shows, its logo is at 100%, the others
  at 20% (Figma: Press logo Default / Active). Mobile: the logo row scrolls sideways and the active logo is centred.
  The tabs rotate every 3 seconds while the section is in view (pause on keyboard focus only, off with reduced
  motion). All quotes sit stacked in one grid cell, so the tallest sets the height and switching never shifts the
  layout. Each quote word is its own span and fades up in turn (30ms apart, 500ms each) when its panel gets [data-active];
  press-tabs.js replays it on every activation, also on click.
  An item without a logo shows its name in caps instead. An item without a quote shows its excerpt (the article
  headline) in the quote's place, without quotation marks.
  A real quote is wrapped in curly quotation marks, inside the first and last word so they animate with them.
  Markup inline in this section (no snippet). The section settings are read into variables at the top.
  Each Press item is one outlet: logo, name (alt text and fallback), quote or excerpt, and article link.
{%- endcomment -%}
{%- liquid
  assign items = section.settings.items
  if items == blank
    assign items = shop.metaobjects.press_item.values
  endif
  assign link_label = 'sections.press.read_article' | t
  assign id = 'Press-' | append: section.id
-%}
{%- if items.size > 0 -%}
  <section class="press bg-background pb-section-md lg:pt-section-md" data-press>
    <press-tabs class="mx-auto flex max-w-page flex-col items-center gap-10 py-8 lg:px-page-margin" data-interval="3000">
      <div class="grid w-full max-w-175">
        {%- for item in items -%}
          {%- liquid
            assign tab_id = id | append: '-tab-' | append: forloop.index
            assign panel_id = id | append: '-panel-' | append: forloop.index
            assign quote = item.quote.value | default: item.excerpt.value
            assign is_quote = false
            if item.quote.value != blank
              assign is_quote = true
            endif
            assign words = quote | split: ' '
            assign url = item.article_link.value
          -%}
          <div
            id="{{ panel_id }}"
            class="group/panel col-start-1 row-start-1 flex flex-col items-center justify-center gap-6 px-3 py-6 text-center text-text lg:gap-8 lg:px-8"
            role="tabpanel"
            aria-labelledby="{{ tab_id }}"
            data-tab-panel
            {% if forloop.first %}data-active{% else %}inert aria-hidden="true"{% endif %}
          >
            {%- if quote != blank -%}
              <blockquote class="text-serif-lg text-balance lg:text-serif-display">
                {%- for word in words -%}
                  <span class="inline-block translate-y-2 opacity-0 blur-xs transition duration-200 ease-out group-data-active/panel:translate-y-0 group-data-active/panel:opacity-100 group-data-active/panel:blur-none group-data-active/panel:duration-500 group-data-active/panel:[transition-delay:calc(150ms+var(--i)*30ms)] group-data-reset/panel:transition-none motion-reduce:transition-none" style="--i: {{ forloop.index0 }}">{% if is_quote and forloop.first %}&ldquo;{% endif %}{{ word | escape }}{% if is_quote and forloop.last %}&rdquo;{% endif %}</span>
                  {%- unless forloop.last -%}{{ ' ' }}{%- endunless -%}
                {%- endfor -%}
              </blockquote>
            {%- endif -%}
            {%- if url != blank and link_label != blank -%}
              <a href="{{ url }}" class="rounded-xs text-link-inline text-text opacity-0 transition duration-200 hover:text-text-muted focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-focus group-data-active/panel:opacity-100 group-data-active/panel:duration-500 group-data-active/panel:[transition-delay:calc(150ms+var(--i)*30ms)] group-data-reset/panel:transition-none motion-reduce:transition-none" style="--i: {{ words.size }}" target="_blank" rel="noopener">{{ link_label }}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="relative w-full">
        <div class="pointer-events-none absolute inset-0 text-text/10 [mask-image:linear-gradient(90deg,transparent_0%,black_20%,black_80%,transparent_100%)] lg:inset-x-19" aria-hidden="true">
          <span class="absolute inset-x-0 top-0 h-px bg-[repeating-linear-gradient(90deg,currentColor_0_2px,transparent_2px_4px)]"></span>
          <span class="absolute inset-x-0 bottom-0 h-px bg-[repeating-linear-gradient(90deg,currentColor_0_2px,transparent_2px_4px)]"></span>
        </div>
        <div class="flex w-full items-center justify-center-safe gap-12 overflow-x-auto px-[50%] [scrollbar-width:none] lg:justify-between lg:gap-6 lg:px-0 relative" role="tablist" data-tab-list>
          {%- for item in items -%}
            {%- liquid
              assign tab_id = id | append: '-tab-' | append: forloop.index
              assign panel_id = id | append: '-panel-' | append: forloop.index
              assign name = item.name.value | escape
              assign logo = item.logo.value
            -%}
            <button
              type="button"
              id="{{ tab_id }}"
              class="press-logo flex h-10 shrink-0 cursor-pointer items-center justify-center rounded-xs text-text opacity-20 transition-opacity duration-150 aria-selected:opacity-100 focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-focus"
              role="tab"
              aria-controls="{{ panel_id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              data-tab
            >
              {%- if logo != blank -%}
                {{ logo | image_url: width: 480 | image_tag: alt: name, sizes: '240px', loading: 'lazy', class: 'block h-10 w-auto' }}
              {%- else -%}
                <span class="text-label-caps-lg">{{ name }}</span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      </div>
    </press-tabs>
  </section>
  <script src="{{ 'press-tabs.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Press quotes",
  "tag": "div",
  "settings": [
    {
      "type": "metaobject_list",
      "id": "items",
      "label": "Press items",
      "metaobject_type": "press_item",
      "limit": 8,
      "info": "Pick entries from Content > Metaobjects > Press item. With none picked, every entry shows."
    }
  ],
  "presets": [
    { "name": "Press quotes" }
  ]
}
{% endschema %}
