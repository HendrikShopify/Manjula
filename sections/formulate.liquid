{%- comment -%}
  Figma: Sections / Formulate (Templates FEEDBACK Science "How we formulate" 2701:25926,
  mobile 2701:25938). Own section (one section per layout) on the breakout grid (.section-breakout, tailwind/tokens.css).
  Desktop: the photo runs from the left edge over columns 1 to 5 (571px tall); the bracketed content over columns 6 to 12
  is as tall as the photo: heading/1 and body/lg (at most 600px wide, Hendrik 23 Nov) at the top, the points (Point blocks) in two columns at the bottom,
  each a body/sm title over a 60% description.
  Mobile: the photo edge to edge (360px; an optional mobile photo replaces it), then the bracketed content stacked:
  heading, body/base, the points in one column with a muted title over a full-strength description.
  The photo can be a video instead (Hendrik, 23 Nov): it plays muted and looped and wins over the photo; a mobile
  photo still replaces it on mobile.
  No parallax: the photos stay still (Hendrik, 23 Nov; the <paralax-img> effect was removed site wide).
{%- endcomment -%}
{%- liquid
  assign main_media = section.settings.video | default: section.settings.image
  assign image_mobile = section.settings.image_mobile | default: main_media
  assign points = section.blocks | where: 'type', 'point'
-%}
<section class="formulate section-shell bg-background text-text" data-padding-top="md" data-padding-bottom="md">
  <div class="section-breakout gap-y-4 lg:gap-y-6">
    <div data-bleed="full" class="lg:hidden">
      <div class="relative h-90 w-full overflow-hidden rounded-media bg-surface-alt">
        {% render 'media', media: image_mobile, ratio: 'fill', autoplay: true, sizes: '100vw', class: 'absolute! inset-0 size-full' %}
      </div>
    </div>
    <div data-bleed="left" class="max-lg:hidden" style="--start: 1; --span: 5;">
      <div class="relative h-142.75 w-full overflow-hidden rounded-media bg-surface-alt">
        {% render 'media', media: main_media, ratio: 'fill', autoplay: true, sizes: '45vw', class: 'absolute! inset-0 size-full' %}
      </div>
    </div>
    <div class="relative flex flex-col gap-10 p-6 lg:justify-between lg:gap-8" style="--start-mobile: 1; --span-mobile: 4; --start: 6; --span: 7;">
      {% render 'bracket', side: 'left', size: 'md', strength: 'light' %}
      <div class="flex flex-col gap-10 lg:gap-8">
        {%- if section.settings.heading != blank -%}
          <h2 class="text-heading-1">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="text-body-base lg:max-w-150 lg:text-body-lg">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if points.size > 0 -%}
        <ul class="flex flex-col gap-8 text-body-sm lg:grid lg:w-128 lg:max-w-full lg:grid-cols-2 lg:gap-10" role="list">
          {%- for block in points -%}
            <li class="flex flex-col gap-4 lg:gap-3" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <p class="max-lg:text-text-muted">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="lg:opacity-60">{{ block.settings.text }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulate",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Runs to the left edge on desktop" },
    { "type": "video", "id": "video", "label": "Video", "info": "Optional. Plays muted and looped instead of the photo; the photo is not needed then." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile photo", "info": "Optional. Shown on mobile instead of the photo." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How we formulate" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Gentle first" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Formulate",
      "blocks": [{ "type": "point" }, { "type": "point" }, { "type": "point" }, { "type": "point" }]
    }
  ]
}
{% endschema %}
