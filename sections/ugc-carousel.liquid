{%- comment -%}
  Figma: Sections / UGC, Layout=Carousel (Blanc). Layout lives in snippets/ugc.liquid.
  Placeholder: no videos yet, so the cards play lorem.video clips until the data source is decided.
{%- endcomment -%}
{% render 'ugc',
  title: section.settings.title,
  layout: 'carousel',
  link_label: section.settings.link_label,
  link_url: section.settings.link_url,
  section_id: section.id
%}

{% schema %}
{
  "name": "UGC: Carousel",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Seen on you"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Heading link",
      "info": "e.g. Follow us"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Heading link URL"
    }
  ],
  "presets": [
    {
      "name": "UGC: Carousel"
    }
  ]
}
{% endschema %}
