{%- comment -%}
  Figma: Sections / Press grid (2152:38139; Templates FINAL About us 2526:25863, mobile 2526:25873), Press card (2152:24891)
  items        Press item metaobjects (press_item: name, logo, quote, excerpt, article_link), picked in the Press items
               setting; with none picked, every Press item entry shows, in admin order (as the Press section)
  link_label   text of the article link ("Read article")
  Optional centred title over Press cards in two columns (one on mobile), 12px apart.
  Press card on Surface: 160x40 logo slot, then a 60% excerpt (max 400px; the item's Excerpt field, never the quote; none shows nothing; at most 3 lines, cut with an ellipsis) and a
  Read article link (only when the item has an article link); it opens the article in a new tab (Hendrik, 23 Nov).
  Mobile: logo and link on one row; the excerpt is not shown (as in Figma).
  An item without a logo shows its name in caps instead. Balanced logos: every logo gets about the same area (60x60px)
  from its own aspect ratio (--logo-ratio, from the file), held inside the 160x40 slot: height = min(40px,
  60px / sqrt(ratio), 160px / ratio), width auto. A wide wordmark (FASHION, 4.5:1) lands near 128x28 as in Figma, a
  tall mark (S, 0.7:1) at 40px high. The height is always set (SVGs with only a viewBox render 0x0 with max-h).
{%- endcomment -%}
{%- liquid
  assign items = section.settings.items
  if items == blank
    assign items = shop.metaobjects.press_item.values
  endif
  assign link_label = section.settings.link_label
-%}
{%- if items.size > 0 -%}
<section class="press-grid mx-auto text-balance flex w-full max-w-page flex-col items-center gap-5 bg-background px-page-margin pb-section-md text-text">
  {%- if section.settings.heading != blank -%}
    <h2 class="text-heading-4 text-center">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <ul class="grid w-full grid-cols-1 gap-3 lg:grid-cols-2" role="list">
    {%- for item in items -%}
      {%- liquid
        assign name = item.name.value
        assign logo = item.logo.value
        assign excerpt = item.excerpt.value
        assign url = item.article_link.value
      -%}
      <li class="flex items-center justify-between gap-6 bg-surface p-6 lg:items-start lg:justify-start">
        <div class="flex h-10 w-40 shrink-0 items-center">
          {%- if logo != blank -%}
            {%- liquid
              assign logo_ratio = logo.aspect_ratio | default: logo.preview_image.aspect_ratio | default: 4
              assign logo_style = '--logo-ratio: ' | append: logo_ratio
            -%}
            {{ logo | image_url: width: 320 | image_tag: alt: name, sizes: '160px', loading: 'lazy', style: logo_style, class: 'block h-[min(--spacing(10),calc(--spacing(15)/sqrt(var(--logo-ratio))),calc(--spacing(40)/var(--logo-ratio)))] w-auto' }}
          {%- else -%}
            <span class="text-label-caps-lg">{{ name }}</span>
          {%- endif -%}
        </div>
        <div class="flex flex-col items-start gap-6 lg:max-w-100 lg:min-w-60 lg:flex-1">
          {%- if excerpt != blank -%}
            <p class="line-clamp-3 text-body-sm opacity-60 max-lg:hidden">{{ excerpt }}</p>
          {%- endif -%}
          {%- if url != blank and link_label != blank -%}
            {% render 'link', label: link_label, href: url, size: 'inline', attributes: 'target="_blank" rel="noopener"' %}
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Press grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "metaobject_list",
      "id": "items",
      "label": "Press items",
      "metaobject_type": "press_item",
      "limit": 12,
      "info": "Leave empty to show every press item"
    },
    { "type": "text", "id": "link_label", "label": "Article link label", "default": "Read article" }
  ],
  "presets": [{ "name": "Press grid" }]
}
{% endschema %}
