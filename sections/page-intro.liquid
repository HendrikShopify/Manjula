{%- comment -%}
  Figma: Sections / Page intro (2225:33776; Templates FINAL Science 2526:25917, mobile 2526:25927)
  Own section on the breakout grid (.section-breakout, tailwind/tokens.css).
  Desktop: the large photo bleeds left over columns 1 to 6 (at least 664px tall); columns 7 to 12 hold the title
  (display/2, max 520px) at the top and, at the bottom, a square photo beside the intro text (body/sm).
  Mobile: title (heading/1), the large photo 440px tall inside the page margins (no bleed), then a 120px square photo
  beside the text.
  Photos are cropped by their frames with the focal point (snippets/media.liquid).
  Text: an empty line between paragraphs (one line height, Hendrik 23 Nov).
  Each photo can be a video instead (Hendrik, 23 Nov): a video plays muted and looped and wins over the photo.
{%- endcomment -%}
{%- liquid
  assign main_media = section.settings.video | default: section.settings.image
  assign detail_media = section.settings.detail_video | default: section.settings.detail_image
-%}
<section class="page-intro section-shell bg-background text-text" data-padding-top="sm" data-padding-bottom="sm">
  <div class="section-breakout [--grid-gap-y:--spacing(5)]">
    {%- if section.settings.heading != blank -%}
      <h1 class="mb-3 text-heading-1 lg:hidden">{{ section.settings.heading }}</h1>
    {%- endif -%}
    <div class="max-lg:order-2 max-lg:pl-page-margin lg:min-h-166" data-bleed="left" style="--start-mobile: 1; --span-mobile: 4; --start: 1; --span: 6;">
      {% render 'media', media: main_media, ratio: 'fill', loading: 'eager', autoplay: true, sizes: '(min-width: 1024px) 53vw, 100vw', class: 'h-110 w-full lg:h-full' %}
    </div>
    <div class="flex flex-col justify-between gap-10 max-lg:order-3" style="--start-mobile: 1; --span-mobile: 4; --start: 7; --span: 6;">
      {%- if section.settings.heading != blank -%}
        <h1 class="max-w-130 text-display-2 max-lg:hidden">{{ section.settings.heading }}</h1>
      {%- endif -%}
      <div class="flex items-start gap-gutter lg:items-end">
        {%- if detail_media != blank -%}
          {% render 'media', media: detail_media, ratio: 'fill', autoplay: true, sizes: '(min-width: 1024px) 23vw, 120px', class: 'size-30 shrink-0 lg:aspect-square lg:size-auto lg:flex-1' %}
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte min-w-0 flex-1 text-body-sm [&_p+p]:mt-[1lh]">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page intro",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where Ayurveda meets modern science" },
    { "type": "image_picker", "id": "image", "label": "Large photo" },
    { "type": "video", "id": "video", "label": "Large video", "info": "Optional. Plays muted and looped instead of the photo; the photo is not needed then." },
    { "type": "image_picker", "id": "detail_image", "label": "Small photo" },
    { "type": "video", "id": "detail_video", "label": "Small video", "info": "Optional. Plays muted and looped instead of the photo; the photo is not needed then." },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Page intro" }]
}
{% endschema %}
