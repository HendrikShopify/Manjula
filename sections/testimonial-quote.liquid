{%- comment -%}
  Figma: Sections / Testimonials, Layout=Quote (215:6694; Templates FINAL Subscription 2526:25882, mobile 2526:25892)
  Own section (one section per layout). Centred Sabon quote (max 477px; serif/lg on mobile, serif/display from lg),
  a 140x180 portrait and a two-line author (name, then role), body/sm.
{%- endcomment -%}
<section class="testimonial-quote mx-auto flex w-full max-w-page flex-col items-center gap-12 bg-background px-page-margin py-section-md text-center text-text lg:gap-15">
  {%- if section.settings.quote != blank -%}
    <blockquote class="max-w-119.25 text-serif-lg lg:text-serif-display">{{ section.settings.quote }}</blockquote>
  {%- endif -%}
  {%- if section.settings.image != blank -%}
    {% render 'media', media: section.settings.image, ratio: 'fill', sizes: '140px', class: 'h-45 w-35 shrink-0' %}
  {%- endif -%}
  {%- if section.settings.author != blank or section.settings.role != blank -%}
    <p class="text-body-sm">
      {{- section.settings.author -}}
      {%- if section.settings.author != blank and section.settings.role != blank %}<br>{% endif -%}
      {{- section.settings.role -}}
    </p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Testimonial: Quote",
  "tag": "div",
  "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote" },
    { "type": "image_picker", "id": "image", "label": "Portrait" },
    { "type": "text", "id": "author", "label": "Name" },
    { "type": "text", "id": "role", "label": "Role", "info": "For example: Face Oil subscriber" }
  ],
  "presets": [{ "name": "Testimonial: Quote" }]
}
{% endschema %}
