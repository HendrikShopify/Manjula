{%- comment -%}
  Figma: Sections / Results timeline (2104:34198; Templates FINAL PDP / Hair oil 2526:26046, mobile 2526:26058)
  Desktop: title, a strong top bracket across the row, then four Timeline steps of 3 columns each.
  Mobile: the steps scroll sideways (230px cards), with a glass Next button over the second card.
  Timeline step (2104:23471): tick marker, dashed line, caps label, image, description.
  The first step is Active; the rest are Upcoming (label and text 60%, image 30%). The caret sits on step 2 and marks
  "you are here" (Figma: Show caret). Steps are blocks.
  JS: results-timeline.js (mobile Next button), hooks data-results-timeline-*.
{%- endcomment -%}
{%- assign steps = section.blocks | where: 'type', 'step' -%}
<script src="{{ 'results-timeline.js' | asset_url }}" defer="defer"></script>
<results-timeline class="results-timeline mx-auto flex w-full max-w-page flex-col gap-6 bg-background py-section-md lg:px-page-margin">
  {%- if section.settings.heading != blank -%}
    <h2 class="px-page-margin text-heading-2 text-text lg:px-0 lg:text-heading-1">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="relative">
    <ol class="flex snap-x snap-mandatory scroll-px-page-margin gap-gutter overflow-x-auto px-page-margin [scrollbar-width:none] lg:grid lg:grid-cols-12 lg:gap-x-gutter lg:overflow-visible lg:px-0 lg:pt-11 lg:pb-11" role="list" data-results-timeline-track>
      {%- for block in steps -%}
        {%- liquid
          assign upcoming = true
          assign image_class = 'h-62.5 w-50 lg:h-31.25 lg:w-25 lg:opacity-30'
          if forloop.first
            assign upcoming = false
            assign image_class = 'h-62.5 w-50 lg:h-31.25 lg:w-25'
          endif
        -%}
        <li class="relative flex w-57.5 shrink-0 snap-start flex-col gap-6 lg:col-span-3 lg:w-auto" {{ block.shopify_attributes }}>
          <span class="absolute -top-11 left-0 h-5 border-l border-dashed border-text opacity-60 max-lg:hidden" aria-hidden="true"></span>
          {%- if forloop.index == 2 -%}
            <span class="absolute -top-4.75 -left-1 h-1.25 w-2.25 rotate-180 text-text max-lg:hidden [&>svg]:size-full" aria-hidden="true">{{ 'icon__caret-down.svg' | inline_asset_content }}</span>
          {%- endif -%}
          <div class="flex gap-3">
            <span class="w-px shrink-0 self-stretch border-l border-dashed border-text/60" aria-hidden="true"></span>
            <div class="flex min-w-0 flex-1 flex-col gap-6 text-text">
              <p class="text-label-caps-lg{% if upcoming %} lg:opacity-60{% endif %}">{{ block.settings.label }}</p>
              {% render 'media', media: block.settings.image, ratio: 'fill', sizes: '(min-width: 1024px) 100px, 200px', class: image_class %}
              {%- if block.settings.text != blank -%}
                <p class="text-body-sm{% if upcoming %} lg:opacity-60{% endif %}">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if steps.size > 1 -%}
      {% render 'bracket', side: 'top', size: 'xs', strength: 'strong', class: 'max-lg:hidden' %}
      <button
        type="button"
        class="absolute top-33.5 left-68.5 flex size-12 cursor-pointer items-center justify-center border border-background/40 bg-text/30 text-background backdrop-blur-sm focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-focus lg:hidden"
        aria-label="{{ 'sections.results_timeline.next' | t | escape }}"
        data-results-timeline-next
      >
        <span class="size-6 [&>svg]:size-full" aria-hidden="true">{{ 'icon__arrow-right.svg' | inline_asset_content }}</span>
      </button>
    {%- endif -%}
  </div>
</results-timeline>


{% schema %}
{
  "name": "Results timeline",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Results timeline" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Immediately" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Results timeline",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
