{%- comment -%}
  Figma: Sections / Contact (2166:38606; Templates FINAL Contact 2526:25968, mobile 2526:25973)
  Desktop (12 columns): the title (heading/1) in columns 4 to 8; below it, 40px down, the contact details in columns 1 to 3
  (one Contact block each: label and an email link at 60%, 40px apart; hover removes the underline) beside the form in columns 4 to 8 (max 496px):
  Underline fields Your name, Your email and Your message (12px apart), then a full-width Send message button 32px below.
  Mobile: title (heading/2), form, then the contact details, 40px apart.
  Labels are visually hidden (Figma shows placeholders only). The form keeps Shopify's contact form fields and messages.
{%- endcomment -%}
{%- liquid
  assign name_label = 'templates.contact.form.name' | t
  assign email_label = 'templates.contact.form.email' | t
  assign message_label = 'templates.contact.form.message' | t
  assign name_placeholder = 'templates.contact.form.name_placeholder' | t
  assign email_placeholder = 'templates.contact.form.email_placeholder' | t
  assign message_placeholder = 'templates.contact.form.message_placeholder' | t
  assign send_label = 'templates.contact.form.send' | t
  assign name_field = 'contact[' | append: name_label | append: ']'
  assign message_field = 'contact[' | append: message_label | append: ']'
  assign contacts = section.blocks | where: 'type', 'contact'
-%}
<div class="main-contact section-shell bg-background text-text" data-padding-top="md" data-padding-bottom="lg">
  <div class="mx-auto grid w-full max-w-page gap-y-10 px-page-margin lg:grid-cols-12 lg:gap-x-gutter">
    {%- if section.settings.heading != blank -%}
      <h1 class="text-heading-2 lg:text-heading-1 lg:col-span-5 lg:col-start-4">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if contacts.size > 0 -%}
      <ul class="flex flex-col gap-10 max-lg:order-last lg:col-span-3 lg:col-start-1 lg:row-start-2" role="list">
        {%- for block in contacts -%}
          <li class="flex flex-col gap-3 text-label-base" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}<p>{{ block.settings.label }}</p>{%- endif -%}
            {%- if block.settings.email != blank -%}
              <a class="text-link-inline w-fit underline opacity-60 hover:no-underline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-focus" href="mailto:{{ block.settings.email | strip }}">{{ block.settings.email }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="w-full lg:col-span-5 lg:col-start-4 lg:row-start-2 lg:max-w-124">
      {%- form 'contact', id: 'ContactForm', class: 'relative flex scroll-mt-20 flex-col gap-8 lg:scroll-mt-19 [&>.h-captcha]:absolute' -%}
        {%- if form.posted_successfully? -%}
          {%- assign success_text = 'templates.contact.form.post_success' | t -%}
          {% render 'helper-text', text: success_text, type: 'success', attributes: 'tabindex="-1" autofocus' %}
        {%- elsif form.errors -%}
          {%- capture error_text -%}{{ 'templates.contact.form.error_heading' | t }} {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}{%- endcapture -%}
          {% render 'helper-text', text: error_text, type: 'error', id: 'ContactForm-error' %}
        {%- endif -%}
        {%- liquid
          assign name_value = form.name | default: customer.name
          assign email_value = form.email | default: customer.email
          assign email_error = false
          if form.errors contains 'email'
            assign email_error = true
          endif
        -%}
        <div class="flex flex-col gap-3">
          <div>
            <label class="sr-only" for="ContactForm-name">{{ name_label }}</label>
            {% render 'input', id: 'ContactForm-name', name: name_field, type: 'text', value: name_value, placeholder: name_placeholder, autocomplete: 'name', style: 'underline' %}
          </div>
          <div>
            <label class="sr-only" for="ContactForm-email">{{ email_label }}</label>
            {% render 'input', id: 'ContactForm-email', name: 'contact[email]', type: 'email', value: email_value, placeholder: email_placeholder, autocomplete: 'email', required: true, error: email_error, describedby: 'ContactForm-error', style: 'underline', attributes: 'spellcheck="false" autocapitalize="off"' %}
          </div>
          <div>
            <label class="sr-only" for="ContactForm-message">{{ message_label }}</label>
            {% render 'textarea', id: 'ContactForm-message', name: message_field, value: form.body, placeholder: message_placeholder, rows: 4, style: 'underline' %}
          </div>
        </div>
        {% render 'button', label: send_label, style: 'primary', size: 'sm', type: 'submit', class: 'w-full' %}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us for help" }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Customer service" },
        { "type": "text", "id": "email", "label": "Email" }
      ]
    }
  ],
  "presets": [{ "name": "Contact", "blocks": [{ "type": "contact" }] }]
}
{% endschema %}
