{%- comment -%}
  Figma: Molecules / Media gallery, Layout=Thumbnails right (the PDP gallery)
  product        Product object (media, selected variant for the first slide)
  sizes          sizes attribute for the images
  class          placement only
  Desktop: a square (1:1) main media, as big as the column allows but never taller than the screen, starting at the left
  edge of the page, with a 60px thumbnail column on the right, 4px gaps. No badge on the media (Hendrik, 20 Nov).
  Mobile: Swiper carousel with carousel-indicators dots on the right (16px inset). Below lg a plain slide (0.3s). From lg
  no slide motion: Swiper swaps the media at once (speed 0) and the new media eases from 110% and a 2px blur into focus
  (1.25s, ease-out-quint), like the Sunset Row retail slider.
  Videos autoplay muted on a loop without controls.
  JS: media-gallery.js
{%- endcomment -%}
<script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign sizes = sizes | default: '(min-width: 1024px) 50vw, 100vw'
  assign media_list = product.media
  assign count = media_list.size
  assign variant = product.selected_or_first_available_variant

  assign selected_index = 1
  for m in media_list
    if m.id == variant.featured_media.id
      assign selected_index = forloop.index
    endif
  endfor

  assign gallery_label = 'products.product.media.gallery_label' | t
-%}
<media-gallery
  class="media-gallery block {{ class }}"
  data-count="{{ count }}"
  data-selected="{{ selected_index }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ gallery_label }}"
>
  <div class="flex flex-col gap-2 lg:flex-row lg:items-start lg:gap-1">
    <div class="relative w-full max-w-[100svh] min-w-0 lg:max-w-[calc(100svh-var(--spacing)*2)] lg:flex-1">
      <div class="swiper overflow-hidden" data-gallery-track tabindex="0">
        <div class="swiper-wrapper flex">
          {%- if count == 0 -%}
            <div class="swiper-slide relative w-full shrink-0" data-gallery-slide>
              {% render 'media', media: nil, ratio: '1:1' %}
            </div>
          {%- endif -%}
          {%- for m in media_list -%}
            {%- liquid
              assign slide_loading = 'lazy'
              if forloop.first
                assign slide_loading = 'eager'
              endif
            -%}
            <div class="swiper-slide relative w-full shrink-0 lg:[&_.media>*]:transition-[scale,filter] lg:[&_.media>*]:duration-1250 lg:[&_.media>*]:ease-out-quint motion-safe:lg:in-[.swiper-initialized]:[&:not(.swiper-slide-active)_.media>*]:scale-110 motion-safe:lg:in-[.swiper-initialized]:[&:not(.swiper-slide-active)_.media>*]:blur-2xs" data-gallery-slide data-media-id="{{ m.id }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ count }}">
              {% render 'media', media: m, ratio: '1:1', sizes: sizes, loading: slide_loading, autoplay: true %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- if count > 1 -%}
      <div class="hidden shrink-0 flex-col gap-1 lg:flex" data-gallery-thumbs>
        {%- for m in media_list -%}
          {%- liquid
            assign is_selected = false
            if forloop.index == selected_index
              assign is_selected = true
            endif
          -%}
          {% render 'media-thumbnail', media: m, selected: is_selected, index: forloop.index, attributes: 'data-g-thumb' %}
        {%- endfor -%}
      </div>
      {% render 'carousel-indicators', count: count, active: selected_index, class: 'justify-end pr-4 lg:hidden' %}
    {%- endif -%}
  </div>
</media-gallery>
