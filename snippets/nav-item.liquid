{%- comment -%}
  Figma: Components Atoms / Nav item
  label     text                                          (Figma: Label)
  href      url; a dropdown without href is a button
  type      link | dropdown                               (Figma: Type)
  current   boolean, sets aria-current only; no visual state (Hendrik, 15 Nov)
  controls  id of the panel a dropdown opens
  class
  A dropdown with an href keeps the label a real link and puts the chevron in its own toggle button, so both stay reachable. The toggle carries data-nav-toggle for header-nav.js; the chevron also flips when an ancestor has group + data-open (the header's list item).
  The label always sits in its own element (span or the inner link) so the global text trim cuts it to cap height the
  same way in every type; a bare text node in the flex box lands about 2px higher.
  States: Hover has no colour change of its own: the header dims the other items to 30% instead (Hendrik, 20 Nov).
  Focus = :focus-visible, Open = group data-open (the caret flips)
{%- endcomment -%}
{%- liquid
  assign type = type | default: 'link'
  assign base = 'nav-item inline-flex h-11 items-center gap-2 text-label-caps-lg text-text'
  assign focus = 'rounded-xs focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-focus'
  assign label_text = label | escape
  assign submenu_label = 'sections.header.submenu' | t: title: label_text
-%}
{%- capture chevron -%}
  <span class="inline-flex shrink-0 group-data-[open]:rotate-180 [&>svg]:block" aria-hidden="true">{{ 'icon__caret-down.svg' | inline_asset_content }}</span>
{%- endcapture -%}
{%- if type == 'dropdown' and href != blank -%}
  <span class="{{ base }} {{ class }}">
    <a href="{{ href }}" class="{{ focus }}"{% if current %} aria-current="page"{% endif %}>{{ label_text }}</a>
    <button type="button" class="inline-flex h-full cursor-pointer items-center {{ focus }}" data-nav-toggle aria-expanded="false"{% if controls %} aria-controls="{{ controls }}"{% endif %}>
      <span class="sr-only">{{ submenu_label }}</span>
      {{ chevron }}
    </button>
  </span>
{%- elsif type == 'dropdown' -%}
  <button type="button" class="{{ base }} cursor-pointer {{ focus }} {{ class }}" data-nav-toggle aria-expanded="false"{% if controls %} aria-controls="{{ controls }}"{% endif %}>
    <span>{{ label_text }}</span>
    {{ chevron }}
  </button>
{%- else -%}
  <a href="{{ href }}" class="{{ base }} {{ focus }} {{ class }}"{% if current %} aria-current="page"{% endif %}><span>{{ label_text }}</span></a>
{%- endif -%}
