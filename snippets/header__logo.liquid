{%- comment -%}
  Figma: Components Atoms / Logo (Type=Wordmark)
  The Manjula wordmark from assets/logo.svg, inlined so it takes the header's text colour (Tone=Inverse over the home hero is white).
  Width as in the Figma header: 120 on mobile, 160 from lg; the height follows the drawing.
{%- endcomment -%}
<a
  href="{{ routes.root_url }}"
  class="inline-flex items-center rounded-xs text-current focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-focus [&>svg]:block [&>svg]:h-auto [&>svg]:w-30 lg:[&>svg]:w-40"
  aria-label="{{ shop.name | escape }}"
  data-focus-fallback
>
  {{- 'logo.svg' | inline_asset_content -}}
</a>
