{%- comment -%}
  Figma: Components Atoms / List row (2114:21299), List header (2114:21300)
  label            caps text
  size             md 13px caps (default) | sm 12px caps | lg 20px caps, 12px padding (Figma: Size)
  active           boolean, the starting state; JS keeps it on aria-pressed (Figma: State=Active)
  trailing_arrow   boolean, an arrow at the end (Figma: Show trailing arrow)
  solid            boolean, full opacity at rest (ingredient index; the list dims the other rows on hover); otherwise rest is 30%
  attributes       JS hooks and data on the button (e.g. data-ingredient-filter="type" data-value="face-oil")
  class            placement only
  A selectable row: 1px dashed lines (1 on, 1 off) top and bottom, shared with the next row (-1px), solid Ink for the
  first 20% and then fading into the background (Figma: gradient stroke). 10px padding (12px at lg).
  Rest 30%, hover 60%, pressed 100%. Pressed slides the arrow in from the left (the row clips it), pushing the label.
  A <button>; the parent decides what pressing it does.
{%- endcomment -%}
{%- liquid
  assign size = size | default: 'md'
  assign box = 'gap-2.5 py-2.5'
  assign arrow = 'w-2.5'
  assign slide = '-ml-5'
  case size
    when 'sm'
      assign text = 'text-label-caps'
    when 'lg'
      assign text = 'text-label-caps-xl'
      assign box = 'gap-3 py-3'
      assign arrow = 'w-4.5'
      assign slide = '-ml-7.5'
    else
      assign text = 'text-label-caps-lg'
  endcase
  if solid
    assign rest = 'opacity-100'
  else
    assign rest = 'opacity-30'
  endif
-%}
<button
  type="button"
  class="list-row group/row relative -mb-px flex w-full cursor-pointer items-center overflow-hidden {{ box }} text-left text-text before:absolute before:inset-x-0 before:top-0 before:h-px after:absolute after:inset-x-0 after:bottom-0 after:h-px before:bg-[repeating-linear-gradient(to_right,var(--color-text)_0_1px,transparent_1px_2px)] after:bg-[repeating-linear-gradient(to_right,var(--color-text)_0_1px,transparent_1px_2px)] before:mask-r-from-20% after:mask-r-from-20% {{ text }} {{ rest }} transition-opacity last:mb-0 hover:opacity-60 aria-pressed:opacity-100 focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-focus {{ class }}"
  aria-pressed="{% if active %}true{% else %}false{% endif %}"
  {%- if attributes %} {{ attributes }}{% endif -%}
>
  <span class="{{ arrow }} {{ slide }} shrink-0 transition-[margin] duration-300 ease-out group-aria-pressed/row:ml-0 motion-reduce:transition-none [&>svg]:h-auto [&>svg]:w-full" aria-hidden="true">{{ 'icon__arrow-list.svg' | inline_asset_content }}</span>
  <span class="min-w-0 flex-1">{{ label }}</span>
  {%- if trailing_arrow -%}
    <span class="{{ arrow }} shrink-0 [&>svg]:h-auto [&>svg]:w-full" aria-hidden="true">{{ 'icon__arrow-list.svg' | inline_asset_content }}</span>
  {%- endif -%}
</button>
