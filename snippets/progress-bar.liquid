{%- comment -%}
  Figma: Components Atoms / Progress bar
  value   0 to 100
  style   accent | success                    (Figma: Style)
  size    xs | sm | md   xs = 2px square line on a 5% Ink track (Use guide)   (Figma: Size)
  label   accessible name
  attributes   JS hooks on the bar; scripts set the width of its [data-progress-fill] child
{%- endcomment -%}
{%- liquid
  assign style = style | default: 'accent'
  assign size = size | default: 'sm'
  assign value = value | default: 0 | at_least: 0 | at_most: 100
  assign track = 'rounded-full bg-surface-alt'
  assign round = 'rounded-full'
  if size == 'md'
    assign height = 'h-2'
  elsif size == 'xs'
    assign height = 'h-0.5'
    assign track = 'bg-text/5'
    assign round = ''
  else
    assign height = 'h-1'
  endif
  if style == 'success'
    assign fill = 'bg-success'
  else
    assign fill = 'bg-accent'
  endif
-%}
<div class="progress-bar w-full {{ height }} overflow-hidden {{ track }} {{ class }}" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ value }}"{% if label %} aria-label="{{ label | escape }}"{% endif %} data-style="{{ style }}"{% if attributes %} {{ attributes }}{% endif %}>
  <div class="h-full {{ round }} {{ fill }} transition-[width] duration-300" style="width: {{ value }}%" data-progress-fill></div>
</div>
