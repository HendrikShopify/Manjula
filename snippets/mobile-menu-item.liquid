{%- comment -%}
  Figma: Components Atoms / Mobile menu item
  Row in the mobile menu.
  label    text                                              (Figma: Label)
  level    1 | 2                                              (Figma: Level) 1 = caps row with divider, like accordion-item caps, 2 = 44px row, lighter, no indent
  href     url, for type link
  current  boolean                                            (Figma: State=Current) medium weight
  class, attributes
  Link rows only. Category rows with children render accordion-item (plus, caps) in mobile-menu.liquid.
  States: Hover = :hover, Focus = :focus-visible
{%- endcomment -%}
{%- liquid
  assign level = level | default: 1
  if level == 2
    assign row = 'flex w-full min-h-11 items-center justify-between text-label-base text-text-muted transition-colors cursor-pointer hover:text-text focus-visible:outline-none focus-visible:underline aria-[current=page]:text-text'
  else
    assign row = 'flex w-full items-center justify-between border-b border-border py-6 text-label-caps-lg text-text transition-colors cursor-pointer hover:text-text-muted focus-visible:outline-none focus-visible:underline'
  endif
-%}
<a href="{{ href }}" class="mobile-menu-item {{ row }} {{ class }}"{% if current %} aria-current="page"{% endif %}{% if attributes %} {{ attributes }}{% endif %}>
  <span>{{ label }}</span>
</a>
