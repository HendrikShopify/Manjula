{%- comment -%}
  Figma: Components Atoms / Media thumbnail
  media      Shopify media object
  selected   boolean, marks the media currently shown            (Figma: State=Selected)
  size       md | sm, 60px (gallery, Manjula) or 56px (lightbox)
  index      1-based position, feeds data-thumb-index and the label
  attributes extra JS hooks, e.g. 'data-media-thumb'
  class      placement only
  Video media shows the play mark (Figma: Type=Video). Manjula: no border; Default 40%, Hover 70%, Selected [aria-current=true] 100%, Focus = 1px focus outline
{%- endcomment -%}
{%- liquid
  assign size = size | default: 'md'
  if size == 'sm'
    assign dim = 'size-14'
  else
    assign dim = 'size-15'
  endif
  assign label = 'products.product.media.show_media' | t: index: index
  assign type = media.media_type | default: 'image'
-%}
<button
  type="button"
  class="media-thumbnail relative flex shrink-0 cursor-pointer items-center justify-center overflow-hidden bg-surface-alt opacity-40 outline-none transition-opacity hover:opacity-70 aria-[current=true]:opacity-100 focus-visible:outline-1 focus-visible:-outline-offset-1 focus-visible:outline-focus {{ dim }} {{ class }}"
  aria-current="{% if selected %}true{% else %}false{% endif %}"
  aria-label="{{ label }}"
  data-thumb-index="{{ index }}"
  {%- if attributes %} {{ attributes }}{% endif -%}
>
  {%- if media.preview_image != blank -%}
    {{ media.preview_image | image_url: width: 200 | image_tag: widths: '100, 144, 200', sizes: '72px', alt: '', class: 'size-full object-cover', loading: 'lazy' }}
  {%- endif -%}
  {%- if type != 'image' and type != 'placeholder' -%}
    <span class="absolute h-2 w-[7px] text-surface-alt [&>svg]:size-full" aria-hidden="true">{{ 'icon__play-solid.svg' | inline_asset_content }}</span>
  {%- endif -%}
</button>
