{%- comment -%}
  Cart trigger in the header. type: icon (default) | text. Text is the Manjula header: "Cart (2)" in 13px caps.
  Re-rendered by cart.js through sections/cart-icon-bubble.liquid, so both callers must pass the same type.
{%- endcomment -%}
{%- liquid
  assign cart_label = 'templates.cart.cart' | t
  if cart.item_count > 0
    assign cart_label = 'sections.header.cart_count' | t: count: cart.item_count
  endif
-%}
{%- if type == 'text' -%}{%- assign cart_label = 'templates.cart.cart' | t -%}{%- endif -%}
{% render 'icon-button', type: type, href: routes.cart_url, icon: 'icon__cart.svg', label: cart_label, count: cart.item_count, style: 'ghost', size: 'md', attributes: 'data-drawer-trigger="cart-drawer" aria-controls="cart-drawer" aria-haspopup="dialog" aria-expanded="false"' %}
