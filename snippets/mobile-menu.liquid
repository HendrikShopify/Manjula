{%- comment -%}
  Figma: Components Atoms / Mobile menu
  Full-screen menu behind the header menu button, sliding in from the left (side-drawer pattern).
  Accordion only: categories expand in place (Hendrik, 18 Nov: drill-down removed, not in the final design).
  Categories render accordion-item (plus, caps), the same accordion as the footer and FAQ. Plain links render mobile-menu-item.
  Close is a text button (icon-button type text), as in Figma.
  Child links to a product render product-card layout tile in a 2-column grid (same tile as featured-collection-tiles),
  in menu order. Then the "All …" row is left out; other children stay text rows.
  menu         linklist
  Bottom bar: language, country (opens upward) and social links.
  The panel is fixed full screen and hidden while data-state="closed"; the drawer fills it (no backdrop: it is full width).
  JS: mobile-menu.js (open/close, slide, focus trap, inert)
{%- endcomment -%}
{%- liquid
  assign uid = section.id | default: 'menu'
  assign all_template = 'mobile_menu.all_of' | t: title: '__title__'
  assign menu_label = 'mobile_menu.title' | t
  assign close_label = 'mobile_menu.close' | t
  assign group_name = 'mobile-nav-' | append: uid
-%}
<mobile-menu class="contents" data-desktop-query="(min-width: 1024px)" data-scroll-lock="false">
  {%- capture menu_attributes -%}data-mobile-menu-open aria-expanded="false" aria-controls="MobileMenu-{{ uid }}"{%- endcapture -%}
  {% render 'icon-button', icon: 'icon__menu.svg', label: menu_label, style: 'ghost', size: 'md', class: 'lg:hidden', attributes: menu_attributes %}

  <div id="MobileMenu-{{ uid }}" class="fixed inset-0 z-30 data-[state=closed]:invisible" data-mobile-menu-panel data-state="closed" role="dialog" aria-modal="true" aria-labelledby="MobileMenuTitle-{{ uid }}">
    <div class="relative flex size-full flex-col overflow-hidden bg-background text-text" data-mobile-menu-drawer>
      <h2 id="MobileMenuTitle-{{ uid }}" class="sr-only">{{ 'mobile_menu.title' | t }}</h2>
      <div class="flex shrink-0 items-center justify-between px-4 py-2">
        {% render 'header__logo' %}
        {% render 'icon-button', type: 'text', label: close_label, size: 'md', attributes: 'data-mobile-menu-close' %}
      </div>

      <nav class="flex-1 overflow-y-auto px-4" aria-label="Main">
        {%- for link in menu.links -%}
          {%- if link.links != blank -%}
            {%- liquid
              assign has_url = false
              if link.url != blank and link.url != '#'
                assign has_url = true
              endif
              assign all_label = all_template | replace: '__title__', link.title
            -%}
            {%- capture tiles -%}
              {%- for child in link.links -%}
                {%- if child.type == 'product_link' and child.object != blank -%}
                  <li>{% render 'product-card', product: child.object, layout: 'tile', section_id: uid, sizes: '50vw' %}</li>
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- capture children -%}
              {%- if tiles != blank -%}
                <ul class="grid grid-cols-2 gap-1" role="list">{{ tiles }}</ul>
              {%- elsif has_url -%}
                {% render 'mobile-menu-item', label: all_label, href: link.url, level: 2, current: link.current %}
              {%- endif -%}
              {%- for child in link.links -%}
                {%- if child.type == 'product_link' and child.object != blank -%}
                  {%- continue -%}
                {%- elsif child.links != blank -%}
                  {%- capture grandchildren -%}
                    {%- for grandchild in child.links -%}
                      {% render 'mobile-menu-item', label: grandchild.title, href: grandchild.url, level: 2, current: grandchild.current %}
                    {%- endfor -%}
                  {%- endcapture -%}
                  {% render 'accordion-item', title: child.title, icon: 'plus', content: grandchildren, open: child.child_active, divider: false %}
                {%- else -%}
                  {% render 'mobile-menu-item', label: child.title, href: child.url, level: 2, current: child.current %}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {% render 'accordion-item', title: link.title, icon: 'plus', style: 'caps', content: children, open: link.child_active, name: group_name %}
          {%- else -%}
            {% render 'mobile-menu-item', label: link.title, href: link.url, current: link.current %}
          {%- endif -%}
        {%- endfor -%}
      </nav>

      <div class="flex shrink-0 items-center justify-between gap-4 bg-surface p-4">
        <div class="flex items-center gap-4">
          {% render 'localization-selector', style: 'ghost', id: 'mobile-localization', placement: 'top', align: 'start' %}
          {% render 'localization-selector', field: 'country', style: 'ghost', id: 'mobile-country', placement: 'top', align: 'start', trigger_style: 'symbol' %}
        </div>
        {% render 'social-links', size: 'sm' %}
      </div>
    </div>
  </div>
</mobile-menu>
