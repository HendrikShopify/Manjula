{%- comment -%}
  Figma: Components Molecules / Purchase options
  Buy box choice between one-time purchase and a subscription (selling plans): two Purchase option cards, the
  subscription card holds the delivery frequencies as Frequency option rows. Renders nothing when the product has no
  selling plan for the selected variant. One-time is selected first.
  product          product object
  product_form_id  id of the product form; the chosen plan goes into it as selling_plan
  popular          plan name (or part of it, e.g. "every 3 months") that gets the Most popular badge
  id               default purchase-options
  The first selling plan group is used; each of its plans is one delivery frequency.
  Radios are not part of the form: purchase-options.js writes the plan id into the hidden selling_plan input.
  JS: purchase-options.js
{%- endcomment -%}
{%- liquid
  assign group = product.selling_plan_groups.first
  assign variant = product.selected_or_first_available_variant
  assign id = id | default: 'purchase-options'
  assign first_alloc = nil
  assign plan_names = ''
  assign plan_ids = ''
  for plan in group.selling_plans
    assign plan_alloc = nil
    for a in variant.selling_plan_allocations
      if a.selling_plan.id == plan.id
        assign plan_alloc = a
      endif
    endfor
    if plan_alloc
      if first_alloc == nil
        assign first_alloc = plan_alloc
        assign first_plan = plan
      endif
      assign plan_names = plan_names | append: plan.name | append: '||'
      assign plan_ids = plan_ids | append: plan.id | append: ','
    endif
  endfor
  assign saving = 0
  if first_alloc and variant.price > first_alloc.price
    assign saving = variant.price | minus: first_alloc.price | times: 100.0 | divided_by: variant.price | round
  endif
  assign saving_badge = ''
  if saving > 0
    assign saving_badge = 'products.product.purchase_options.savings' | t: percent: saving
  endif
  assign t_popular = 'products.product.purchase_options.most_popular' | t
  assign t_legend = 'products.product.purchase_options.legend' | t
  assign t_one_time = 'products.product.purchase_options.one_time' | t
  assign t_subscribe = 'products.product.purchase_options.subscribe' | t
  assign t_every = 'products.product.purchase_options.deliver_every' | t
  assign t_cancel = 'products.product.purchase_options.cancel_anytime' | t
  assign names = plan_names | split: '||'
  assign ids = plan_ids | split: ','
  assign type_name = 'purchase-type-' | append: id
  assign one_time_id = type_name | append: '-one-time'
  assign subscription_id = type_name | append: '-subscription'
  assign freq_name = 'purchase-frequency-' | append: id
-%}
{%- if first_alloc -%}
<script src="{{ 'purchase-options.js' | asset_url }}" defer="defer"></script>
<purchase-options class="purchase-options block" id="{{ id }}">
  <input type="hidden" name="selling_plan" value="" form="{{ product_form_id }}" data-purchase-plan>

  <div hidden data-purchase-prices>
    <template data-plan="one-time">{% render 'price', price: variant.price, compare_at_price: variant.compare_at_price, size: 'sm' %}</template>
    {%- for plan in group.selling_plans -%}
      {%- for a in variant.selling_plan_allocations -%}
        {%- if a.selling_plan.id == plan.id -%}
          <template data-plan="{{ plan.id }}">{% render 'price', price: a.price, compare_at_price: variant.price, size: 'sm' %}</template>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>

  {%- capture details -%}
    <div class="flex flex-col" role="radiogroup" aria-label="{{ t_every | escape }}">
      {%- for plan_id in ids -%}
        {%- liquid
          assign row_id = freq_name | append: '-' | append: plan_id
          assign row_badge = ''
          if popular != blank and names[forloop.index0] contains popular
            assign row_badge = t_popular
          endif
        -%}
        {%- comment -%} The plan name minus a savings suffix ("Deliver every 3 months, 15% off"): the saving already shows on the Subscribe row {%- endcomment -%}
        {%- assign row_label = names[forloop.index0] | split: ', ' | first -%}
        {% render 'frequency-option', label: row_label, badge: row_badge, id: row_id, name: freq_name, value: plan_id, checked: forloop.first, attributes: 'data-frequency-pill' %}
      {%- endfor -%}
    </div>
    {% render 'icon-text', text: t_cancel, icon: 'icon__pause-circle.svg', size: 'xs', class: 'self-center' %}
  {%- endcapture -%}
  <fieldset class="isolate flex flex-col">
    <legend class="sr-only">{{ t_legend }}</legend>
    {% render 'purchase-option', type: 'one-time', label: t_one_time, price: variant.price, compare_at_price: variant.compare_at_price, name: type_name, value: 'one-time', id: one_time_id, checked: true, price_key: 'one-time' %}
    {% render 'purchase-option', type: 'subscription', label: t_subscribe, badge: saving_badge, price: first_alloc.price, compare_at_price: variant.price, name: type_name, value: 'subscription', id: subscription_id, content: details, checked: false, price_key: first_plan.id %}
  </fieldset>
</purchase-options>
{%- endif -%}
