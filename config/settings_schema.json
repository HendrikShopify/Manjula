[
  {
    "name": "theme_info",
    "theme_name": "SlashCheckout - Stack",
    "theme_version": "2.0",
    "theme_author": "SlashCheckout",
    "theme_documentation_url": "https://slashcheckout.com/",
    "theme_support_url": "https://slashcheckout.com/"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "The small icon in the browser tab. Use a square image of at least 180 x 180 px."
      }
    ]
  },
  {
    "name": "Products",
    "settings": [
      {
        "type": "richtext",
        "id": "delivery_returns",
        "label": "Delivery and returns",
        "info": "Shown in the product details drawer.",
        "default": "<p>Made in Canada, sustainably packaged and travel-sized. Free standard shipping on orders over the threshold. Not happy with it? Return unused items within 30 days for a refund.</p>"
      },
      {
        "type": "url",
        "id": "delivery_returns_link",
        "label": "Delivery and returns page",
        "info": "Shown as a link under the delivery and returns text."
      }
    ]
  },
  {
    "name": "Delivery estimate",
    "settings": [
      {
        "type": "paragraph",
        "content": "The \"Estimated delivery\" date under Add to cart. It counts from today, using the visitor's country. Countries not listed below use the default."
      },
      { "type": "checkbox", "id": "show_delivery_estimate", "label": "Show estimated delivery", "info": "On the product page, under Add to cart.", "default": true },
      { "type": "range", "id": "delivery_days", "label": "Days to delivery (default)", "min": 1, "max": 30, "step": 1, "default": 7 },
      { "type": "checkbox", "id": "delivery_business_days", "label": "Count business days only", "info": "Saturdays and Sundays are skipped.", "default": true },
      { "type": "range", "id": "delivery_cutoff_hour", "label": "Order cut-off time", "min": 0, "max": 24, "step": 1, "unit": "h", "default": 14, "info": "Orders after this hour (store time zone) ship a day later. 24 turns it off." },
      { "type": "header", "content": "Country 1" },
      { "type": "text", "id": "delivery_country_1", "label": "Country code", "info": "Two letters, e.g. CA, US, GB. Separate more countries with a comma.", "default": "CA" },
      { "type": "range", "id": "delivery_days_1", "label": "Days to delivery", "min": 1, "max": 30, "step": 1, "default": 3 },
      { "type": "header", "content": "Country 2" },
      { "type": "text", "id": "delivery_country_2", "label": "Country code", "default": "US" },
      { "type": "range", "id": "delivery_days_2", "label": "Days to delivery", "min": 1, "max": 30, "step": 1, "default": 5 },
      { "type": "header", "content": "Country 3" },
      { "type": "text", "id": "delivery_country_3", "label": "Country code", "default": "GB" },
      { "type": "range", "id": "delivery_days_3", "label": "Days to delivery", "min": 1, "max": 30, "step": 1, "default": 7 },
      { "type": "header", "content": "Country 4" },
      { "type": "text", "id": "delivery_country_4", "label": "Country code" },
      { "type": "range", "id": "delivery_days_4", "label": "Days to delivery", "min": 1, "max": 30, "step": 1, "default": 7 },
      { "type": "header", "content": "Country 5" },
      { "type": "text", "id": "delivery_country_5", "label": "Country code" },
      { "type": "range", "id": "delivery_days_5", "label": "Days to delivery", "min": 1, "max": 30, "step": 1, "default": 7 }
